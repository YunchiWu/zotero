{
  "name": "@yunchiwu/zotero-deepseek-harness",
  "version": "0.2.0",
  "private": true,
  "description": "Use a local Zotero Desktop library from DeepSeek Harness: search, export BibTeX, insert citations, read indexed text, and import references.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./icon": "./assets/icon.png",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./assets/icon.png",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.png",
    "skills/zotero/SKILL.md",
    "skills/zotero/scripts/zotero.py",
    "skills/zotero/references/*.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunchiWu/zotero.git"
  },
  "homepage": "https://github.com/YunchiWu/zotero",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "zotero",
    "citations",
    "bibliography",
    "bibtex",
    "references",
    "research"
  ]
}
